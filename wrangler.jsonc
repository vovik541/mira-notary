{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mira-notary",
  "main": "dist/mira-notary/server/server.mjs",
  "compatibility_date": "2026-08-23",
  // Angular SSR (platform-server) needs Node built-ins.
  "compatibility_flags": ["nodejs_compat"],

  // Prerendered pages + JS/CSS/images are served from here before the Worker runs.
  // `run_worker_first` makes sure /api/* (and the generated /robots.txt + /sitemap.xml) reach the Worker.
  "assets": {
    "directory": "./dist/mira-notary/browser",
    "binding": "ASSETS",
    // Serve /about (not /about/): prerendered pages live at about/index.html.
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*", "/robots.txt", "/sitemap.xml"]
  },

  // Non-secret runtime configuration for appointment emails (sent through Resend).
  // Changing environments (test → Mira's production) is a change to these values only.
  "vars": {
    // Production sender: the isolated notify. subdomain of miranotary.com (verify it in Resend and add
    // the DNS records Resend lists; do not touch the root-domain MX records).
    "EMAIL_FROM_ADDRESS": "appointments@notify.miranotary.com",
    "EMAIL_FROM_NAME": "Local Notary Signings by Mira Derkach",

    // Where appointment notifications are delivered. Server-side only, never sent to the browser
    // and never accepted from a request. (Locally, .dev.vars overrides it with a test mailbox.)
    "APPOINTMENT_RECIPIENT": "miranotary@gmail.com"
  },

  // Modest abuse limit: 5 requests / 60 s per client IP, per Cloudflare location (approximate,
  // eventually consistent). Turnstile is the primary protection.
  "ratelimits": [
    {
      "name": "APPOINTMENT_RATE_LIMIT",
      "namespace_id": "4801",
      "simple": { "limit": 5, "period": 60 }
    }
  ]

  // Secrets are NOT stored here. Set them with:
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put TURNSTILE_SECRET_KEY
}
